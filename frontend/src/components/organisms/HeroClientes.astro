---
/**
 * Hero de la vertiente comercial.
 *
 * Mismo vocabulario visual que HeroEmpresas —seccion al 95/90 %, titular con
 * clamp, linea mono de acento y un bloque destacado sobre fondo slate— porque
 * las dos vertientes son el mismo sitio y el visitante cruza de una a otra.
 * Lo que cambia es el lector: aqui no hay reclutador, hay alguien con un
 * problema de negocio, asi que el copy habla de resultados y no de stack.
 *
 * Va en .astro y sin framer-motion a proposito. El hero anterior enviaba a
 * cliente parallax, glows animados en bucle y una textura de grano en base64
 * para un bloque que solo es texto; nada de eso ayudaba a leer el titular.
 *
 * data-cta="primary" marca el unico CTA primario de la pagina, que es lo que
 * comprueba el criterio de aceptacion del skill de clientes.
 */

/** Los tres dolores van en lenguaje del cliente: ni una palabra tecnica. */
const DOLORES = [
  'Llevas el inventario en un cuaderno o en una hoja de calculo que ya nadie entiende.',
  'Para saber cuanto vendiste hoy tienes que preguntar, contar o cerrar la tienda.',
  'Los pedidos llegan por WhatsApp y se pierden entre las conversaciones.',
];

const TITULO = 'Yamid Dev, programador freelancer';
const LETRAS = Array.from(TITULO);
---

<section id="inicio" class="relative isolate w-full overflow-hidden py-20 sm:py-20 lg:py-28">
  <img src="/blog.jpg" alt="Cuaderno de trabajo sobre un fondo oscuro" class="absolute inset-0 z-0 h-full w-full object-cover" width="1200" height="630" />
  <div class="absolute inset-0 z-0 bg-gradient-to-br from-slate-950/85 via-slate-950/65 to-cyan-950/75" aria-hidden="true"></div>
  <div class="relative z-10 mx-auto grid w-[90%] max-w-6xl items-end gap-16 lg:grid-cols-[minmax(0,1fr)_minmax(16rem,22rem)] lg:gap-20">
    <div class="max-w-3xl text-center lg:text-left">
      <p class="mb-7 flex items-center justify-center gap-3 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-cyan-200 sm:text-xs sm:tracking-[0.18em] lg:justify-start">
        <span class="hidden h-px w-8 bg-cyan-300 lg:block" aria-hidden="true"></span>
        Soluciones digitales para negocios · Colombia y Latinoamérica
      </p>

    <h1
      class="max-w-3xl text-[clamp(2.7rem,10.5vw,4.75rem)] font-semibold leading-[0.94] tracking-[-0.06em] text-white drop-shadow-sm sm:text-[clamp(2.4rem,6vw,4.75rem)]"
      aria-label={TITULO}
    >
      <span aria-hidden="true">
        {LETRAS.map((letra, i) =>
          letra === ' ' ? ' ' : (
            <span class="hero-letter" style={`--i:${i}`}>{letra}</span>
          )
        )}
      </span>
    </h1>

    <p class="mt-8 max-w-xl text-[clamp(1.05rem,2vw,1.25rem)] leading-relaxed text-slate-200">
      Desarrollo soluciones digitales para organizar operaciones, ventas y clientes. Trabajo con
      negocios de Colombia, Latinoamérica y, de forma cercana, con empresas de Chitagá y la región.
    </p>

    <div class="mt-10 flex flex-wrap justify-center gap-3 lg:justify-start">
      <a
        href="#contacto"
        data-cta="primary"
        class="inline-flex min-h-[44px] items-center rounded-full bg-slate-950 px-6 text-sm font-medium text-white transition-colors hover:bg-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:ring-offset-2 motion-reduce:transition-none dark:bg-white dark:text-slate-950 dark:hover:bg-slate-200 dark:focus-visible:ring-offset-slate-950"
      >
        Hablemos de tu proyecto
      </a>
      <a
        href="#proyectos"
        class="inline-flex min-h-[44px] items-center rounded-full px-6 text-sm font-medium text-white ring-1 ring-white/60 transition-colors hover:bg-white/15 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-300 focus-visible:ring-offset-2 motion-reduce:transition-none"
      >
        Ver proyectos
      </a>
    </div>
    </div>

    <aside class="border-t border-white/25 pt-7 text-center dark:border-white/25 lg:border-l lg:border-t-0 lg:pl-7 lg:pt-0 lg:text-left">
      <h2 class="text-sm font-semibold text-white">¿Te suena alguna?</h2>
      <ul class="mt-4 space-y-3">
        {DOLORES.map((dolor) => (
          <li class="flex gap-3 text-sm leading-relaxed text-slate-200">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-cyan-600 dark:bg-cyan-400" aria-hidden="true"></span>
            {dolor}
          </li>
        ))}
      </ul>
      <p class="mt-5 text-sm font-medium text-white">
        Si te pasa alguna, esto se puede resolver.
      </p>
    </aside>
  </div>
</section>
