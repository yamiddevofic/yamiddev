---
import '../styles/global.css';
import Layout from '../Layout/Layout.astro';
import Title from '../components/atoms/Title'

const items = Array.from({ length: 20 });
---

<Layout title="Yamid Dev | Desarrollador freelancer">
	<div class="container mx-auto h-screen p-4 bg-yellow-200 text-base">
		{items.map((_, i) => (
			<Title className="text-primary" level="h1" key={i}>
				Hola
			</Title>
		))}
	</div>
</Layout>
