---
import { Projects } from '../../lib/projectData';

/**
 * Trabajos, en la vertiente comercial.
 *
 * Reemplaza al carrusel anterior por una rejilla estatica con las mismas
 * tarjetas que usa la vertiente tecnica. Tres razones, en orden de peso:
 *
 * 1. Es el mismo sitio y tenia dos lenguajes visuales distintos.
 * 2. La rejilla no necesita JavaScript. El carrusel enviaba una isla de React
 *    con framer-motion para mostrar cuatro tarjetas que caben en pantalla.
 * 3. El carrusel estaba roto en movil: la pista llevaba overflow-hidden en vez
 *    de overflow-x-auto, asi que sin los botones —ocultos por debajo de sm—
 *    no habia forma de llegar a los proyectos que no fueran el primero.
 *
 * La tarjeta no es un enlace entero: dentro hay un unico <a> al final. Anidar
 * un <a> dentro de otro es HTML invalido y el parser lo deshacia, con lo que
 * el DOM dejaba de coincidir con el arbol de React y la isla se rehidrataba.
 */
---

<section id="trabajos" class="mx-auto w-[90%] max-w-6xl py-20 sm:py-24">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
    <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.04em] text-slate-950 dark:text-white">
      Trabajos
    </h2>
    <p class="max-w-sm text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      Soluciones desarrolladas para resolver necesidades concretas.
    </p>
  </div>

  <ul class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(min(100%,20rem),1fr))] gap-x-8 gap-y-12">
    {Projects.map((p) => (
      <li class="group flex flex-col">
        <!-- Par de capturas: la clara y la oscura, para que la imagen no
             desentone con el tema activo. -->
        <div class="aspect-[16/9] h-auto w-full overflow-hidden bg-slate-100 dark:bg-slate-800">
          <img
            src={p.image[0]}
            alt={`Captura de ${p.title}`}
            width={p.imageSize?.width}
            height={p.imageSize?.height}
            loading="lazy"
            decoding="async"
            class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none dark:hidden"
          />
          <img
            src={p.image[1]}
            alt={`Captura de ${p.title}`}
            width={p.imageSize?.width}
            height={p.imageSize?.height}
            loading="lazy"
            decoding="async"
            class="hidden h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none dark:block"
          />
        </div>

        <div class="flex flex-1 flex-col border-t border-slate-200 pt-5 dark:border-slate-800">
          <div class="flex items-start justify-between gap-3">
            <h3 class="font-semibold tracking-tight text-slate-950 transition-colors group-hover:text-cyan-700 dark:text-white dark:group-hover:text-cyan-400">{p.title}</h3>
            <span class="shrink-0 font-mono text-[0.7rem] text-slate-500 dark:text-slate-400">
              {p.time}
            </span>
          </div>

          <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            {p.description}
          </p>

          <ul class="mt-5 flex flex-wrap gap-x-3 gap-y-1.5">
            {p.techStack.map((t) => (
              <li class="font-mono text-[0.7rem] text-slate-500 dark:text-slate-400">
                {t}
              </li>
            ))}
          </ul>

          <div class="mt-auto pt-7">
            <a
              href={p.url}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[44px] items-center text-xs font-medium text-cyan-700 underline decoration-cyan-300 underline-offset-4 transition-colors hover:text-cyan-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:ring-offset-2 motion-reduce:transition-none dark:text-cyan-400 dark:decoration-cyan-700 dark:hover:text-cyan-300 dark:focus-visible:ring-offset-slate-950"
            >
              Ver código
            </a>
          </div>
        </div>
      </li>
    ))}
  </ul>
</section>
