---
import Navbar from "../components/organisms/Navbar";
import Footer from "../components/organisms/Footer.astro";
import { SITE } from "@/config/site";
import {
  createPageMeta,
  createStructuredData,
  type ArticleDetails,
  type CourseDetails,
  type PageType,
} from "@/lib/seo";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  icon?: string;
  canonical?: string;
  noindex?: boolean;
  lang?: string;
  isMain?: boolean;
  header?: boolean;
  pageType?: PageType;
  keywords?: string[];
  courseDetails?: CourseDetails;
  articleDetails?: ArticleDetails;
}

const {
  title,
  description,
  image,
  icon = SITE.icon,
  canonical,
  noindex = false,
  lang = "es",
  isMain = false,
  header = true,
  pageType = "website",
  keywords = [],
  courseDetails,
  articleDetails,
} = Astro.props as Props;

const meta = createPageMeta(
  { title, description, image, icon, canonical, noindex, lang, keywords },
  Astro.url.href,
  Astro.site ?? Astro.url.origin
);

const schema = createStructuredData(meta, {
  title,
  pageType,
  courseDetails,
  articleDetails,
  lang,
});
---

<!doctype html>
<html lang={lang} class="dark">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonicalUrl} />
    <meta name="robots" content={meta.robots} />

    <!-- Favicons -->
    <link rel="icon" type="image/jpeg" href={meta.iconPath} sizes="any" />
    <link rel="icon" type="image/jpeg" href={meta.iconPath} sizes="32x32" />
    <link rel="apple-touch-icon" href={meta.iconPath} />
    <meta name="msapplication-TileImage" content={meta.iconUrl} />

    <!-- Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&display=swap" rel="stylesheet">

    <!-- Open Graph -->
    <meta property="og:type" content={pageType === "article" ? "article" : "website"} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonicalUrl} />
    <meta property="og:image" content={meta.imageUrl} />
    <meta property="og:locale" content={meta.locale} />

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.imageUrl} />
    <meta name="twitter:site" content={SITE.twitter.site} />
    <meta name="twitter:creator" content={SITE.twitter.creator} />

    <!-- SEO -->
    <meta name="author" content={SITE.author} />
    <meta name="keywords" content={meta.keywords} />
    <meta name="theme-color" content={SITE.themeColor} />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body
    class="bg-white dark:bg-gray-800 text-gray-800 dark:text-white transition-colors duration-300 flex flex-col min-h-[100vh]"
>
    {header && <Navbar client:load isMain={isMain} />}
    <main class="w-full h-auto flex items-center justify-center flex-grow flex-col overflow-x-hidden">
        <slot />
    </main>
    <Footer />
</body>
</html>
