---
import MainLayout from '../layouts/MainLayout.astro';
import HeroEmpresas from '../components/organisms/HeroEmpresas.astro';
import ProyectosTecnicos from '../components/organisms/ProyectosTecnicos.astro';
import StackYTrayectoria from '../components/organisms/StackYTrayectoria.astro';
import ContactForm from '../components/organisms/ContactForm';
import '../styles/global.css';

/**
 * Home técnica: la vertiente para postularse a empresas.
 *
 * El orden de secciones lo fija el skill agent-portfolio-empresas y es
 * deliberado: identificación → actividad reciente → evidencia → contexto →
 * acción. Los proyectos van antes que el stack porque una lista de tecnologías
 * no prueba nada; el sistema desplegado, sí.
 *
 * La vertiente comercial vive en /clientes y se dirige a otro lector.
 */
const pageDetails = {
  // El title lleva nombre + rol + stack, que es como busca un reclutador.
  title: 'Desarrollador Full-Stack JavaScript / Python',
  description:
    'Yamid Horacio Rodríguez, desarrollador full-stack en Colombia. Construyo y mantengo sistemas en producción con JavaScript, React, Astro y Python. Proyectos con código público.',
  image: '/dev.jpg',
  canonical: 'https://www.yamid.dev/',
  icon: '/dev.jpg',
  keywords: [
    'desarrollador full stack',
    'desarrollador javascript colombia',
    'desarrollador react remoto',
    'desarrollador python',
    'astro developer',
    'yamid rodriguez',
  ],
};
---

<MainLayout
  title={pageDetails.title}
  description={pageDetails.description}
  image={pageDetails.image}
  canonical={pageDetails.canonical}
  icon={pageDetails.icon}
  keywords={pageDetails.keywords}
  isMain={true}
  pageType="website"
>
  <div class="w-full bg-white transition-colors duration-300 dark:bg-slate-950">
    <HeroEmpresas />
    <ProyectosTecnicos />
    <StackYTrayectoria />

    <div id="contacto">
      <ContactForm client:visible />
    </div>

    <!-- Puente a la otra vertiente: quien llega buscando contratar un servicio
         no debería quedarse en una página escrita para reclutadores. -->
    <section class="w-[95%] md:w-[90%] mx-auto pb-16">
      <div class="rounded-lg bg-slate-100 p-6 ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
        <p class="text-sm text-slate-600 dark:text-slate-300">
          ¿Buscas a alguien que construya un sistema para tu negocio?
          <a
            href="/clientes"
            class="ml-1 inline-flex min-h-[44px] items-center font-medium text-cyan-700 underline underline-offset-4 transition-colors hover:text-cyan-800 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:ring-offset-2 motion-reduce:transition-none dark:text-cyan-400 dark:hover:text-cyan-300 dark:focus-visible:ring-offset-slate-900"
          >
            Mira los servicios
          </a>
        </p>
      </div>
    </section>
  </div>
</MainLayout>
