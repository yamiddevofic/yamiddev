const anio = new Date().getFullYear();
---

<footer class="mt-auto border-t border-slate-200 bg-white dark:border-slate-800 dark:bg-slate-950">
  <div class="mx-auto w-[95%] md:w-[90%] py-8">
    <div class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between">
      <!-- En fila: los enlaces conservan sus 44 px de alto sin apilarse. -->
      <nav aria-label="Pie de página">
        <ul class="flex flex-wrap items-center gap-x-1 gap-y-0">
          {PAGINAS.map((p) => (
            <li>
              <a
                href={p.href}
                class="inline-flex min-h-[44px] items-center rounded-md px-2.5 text-sm text-slate-600 transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600 motion-reduce:transition-none dark:text-slate-400 dark:hover:text-white dark:focus-visible:ring-cyan-400"
              >
                {p.titulo}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <ul class="flex items-center gap-1">
        {REDES.map((r) => (
          <li>
            <a
              href={r.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={r.nombre}
              class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-md text-slate-500 transition-colors hover:text-slate-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-600 motion-reduce:transition-none dark:text-slate-400 dark:hover:text-white dark:focus-visible:ring-cyan-400"
            >
              <svg class="h-5 w-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path d={r.d} />
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>

    <p class="mt-6 border-t border-slate-200 pt-6 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
      © {anio} Yamid Horacio Rodríguez · Chitagá, Colombia
    </p>
  </div>
</footer>
