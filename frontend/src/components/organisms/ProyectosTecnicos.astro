---
import { PROYECTOS } from '../../lib/empresasData';

/**
 * Evidencia técnica.
 *
 * La regla de las tres evidencias del skill dice que cada proyecto necesita
 * demo viva + repo + write-up, y que si falta una no va en la home. Aquí se
 * cumple sin fingir: solo se pinta el enlace de la evidencia que existe de
 * verdad. Un enlace de demo roto es peor que no listarlo, porque sugiere
 * abandono; e inventar un write-up que no está escrito sería peor todavía.
 *
 * Cuando un proyecto reúna las tres, se marca `enHome: true` en empresasData
 * y sube al principio de la lista.
 */
const ordenados = [...PROYECTOS].sort((a, b) => Number(b.enHome) - Number(a.enHome));
---

<section id="proyectos" class="mx-auto w-[90%] max-w-6xl py-20 sm:py-24">
  <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between sm:gap-8">
    <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.04em] text-slate-950 dark:text-white">
      Proyectos
    </h2>
    <p class="max-w-sm text-sm leading-relaxed text-slate-600 dark:text-slate-400">
      Sistemas construidos, desplegados y documentados.
    </p>
  </div>

  <ul class="mt-8 grid grid-cols-[repeat(auto-fit,minmax(min(100%,20rem),1fr))] gap-x-8 gap-y-12">
    {ordenados.map((p) => (
      <li class="group flex flex-col border-t border-slate-200 pt-5 dark:border-slate-800">
        {p.image && (
          <div class="mb-5 aspect-[16/9] w-full overflow-hidden bg-slate-100 dark:bg-slate-800">
            <img
              src={p.image[0]}
              alt={`Captura de ${p.nombre}`}
              width="1366"
              height="768"
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none dark:hidden"
            />
            <img
              src={p.image[1]}
              alt={`Captura de ${p.nombre}`}
              width="1366"
              height="768"
              loading="lazy"
              decoding="async"
              class="hidden h-full w-full object-cover object-top transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none dark:block"
            />
          </div>
        )}
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-semibold tracking-tight text-slate-950 transition-colors group-hover:text-cyan-700 dark:text-white dark:group-hover:text-cyan-400">
            {p.nombre}
          </h3>
          <span class="shrink-0 font-mono text-[0.7rem] text-slate-500 dark:text-slate-400">
            {p.estado}
          </span>
        </div>

        <p class="mt-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">{p.resumen}</p>

        <p class="mt-4 text-xs leading-relaxed text-slate-500 dark:text-slate-400">
          <span class="font-medium text-slate-700 dark:text-slate-300">Rol</span>
          <span class="mx-1.5 text-slate-300 dark:text-slate-600">/</span>
          {p.rol}
        </p>

        <ul class="mt-5 flex flex-wrap gap-x-3 gap-y-1.5">
          {p.stack.map((t) => (
            <li class="font-mono text-[0.7rem] text-slate-500 dark:text-slate-400">
              {t}
            </li>
          ))}
        </ul>

        <div class="mt-auto flex flex-wrap gap-x-5 gap-y-2 pt-7">
          {p.demo && (
            <a
              href={p.demo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[44px] items-center text-xs font-medium text-cyan-700 underline decoration-cyan-300 underline-offset-4 transition-colors hover:text-cyan-900 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:ring-offset-2 motion-reduce:transition-none dark:text-cyan-400 dark:decoration-cyan-700 dark:hover:text-cyan-300 dark:focus-visible:ring-offset-slate-950"
            >
              Ver en vivo
            </a>
          )}
          {p.repo && (
            <a
              href={p.repo}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex min-h-[44px] items-center text-xs font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 transition-colors hover:text-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:ring-offset-2 motion-reduce:transition-none dark:text-slate-300 dark:decoration-slate-700 dark:hover:text-white dark:focus-visible:ring-offset-slate-950"
            >
              Código
            </a>
          )}
          {p.writeup && (
            <a
              href={p.writeup}
              class="inline-flex min-h-[44px] items-center text-xs font-medium text-slate-600 underline decoration-slate-300 underline-offset-4 transition-colors hover:text-slate-950 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:ring-offset-2 motion-reduce:transition-none dark:text-slate-300 dark:decoration-slate-700 dark:hover:text-white dark:focus-visible:ring-offset-slate-950"
            >
              Cómo está hecho
            </a>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>
