---
import { STACK } from '../../lib/empresasData';
import {
  SiAstro,
  SiDocker,
  SiFlask,
  SiFlutter,
  SiGit,
  SiJavascript,
  SiMysql,
  SiPython,
  SiReact,
  SiTailwindcss,
  SiTypescript,
  SiVercel,
} from 'react-icons/si';

/**
 * Herramientas, version comercial.
 *
 * El skill de clientes prohibe la rejilla de logos de tecnologias como seccion
 * principal, y con razon: al dueno de un negocio los iconos de colores no le
 * dicen nada y le quitan sitio a lo que si decide la compra. Aqui queda como
 * bloque compacto y al final, con la misma marca que el stack de la vertiente
 * tecnica, y leyendo del mismo origen de datos para que no se contradigan.
 *
 * Sustituye a Technology.tsx, que pintaba doce tarjetas de 200 px con glow,
 * rotacion al pasar el raton y react-icons cargado en el cliente.
 */
---

<section id="herramientas" class="mx-auto w-[90%] max-w-6xl py-20 sm:py-24">
  <div class="max-w-3xl">
    <h2 class="text-[clamp(1.75rem,3.5vw,2.5rem)] font-semibold tracking-[-0.04em] text-slate-950 dark:text-white">
      Con qué lo construyo
    </h2>
    <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">
      No necesitas saber qué es cada una. Está aquí por si quieres consultarlo con alguien de confianza.
    </p>
  </div>

  <div class="mt-10 grid grid-cols-[repeat(auto-fit,minmax(min(100%,18rem),1fr))] gap-x-8 gap-y-10">
    {STACK.map((g) => (
      <div>
        <div class="flex flex-wrap items-baseline gap-x-2">
          <h3 class="text-sm font-semibold text-slate-900 dark:text-white">{g.grupo}</h3>
          <span class="text-xs text-slate-500 dark:text-slate-400">— {g.nota}</span>
        </div>
        <ul class="mt-4 flex flex-wrap gap-x-4 gap-y-3">
          {g.items.map((t) => (
            <li class="inline-flex items-center font-mono text-xs text-slate-600 dark:text-slate-300">
              <span class="mr-1.5 inline-flex text-sm" aria-hidden="true">
                {t === 'JavaScript' && <SiJavascript className="text-yellow-500" />}
                {t === 'React' && <SiReact className="text-[#61DAFB]" />}
                {t === 'Astro' && <SiAstro className="text-orange-500" />}
                {t === 'Tailwind' && <SiTailwindcss className="text-sky-400" />}
                {t === 'Vercel' && <SiVercel className="text-slate-950 dark:text-white" />}
                {t === 'Git' && <SiGit className="text-orange-600" />}
                {t === 'Python' && <SiPython className="text-blue-500" />}
                {t === 'Flask' && <SiFlask className="text-slate-950 dark:text-white" />}
                {t === 'MySQL' && <SiMysql className="text-blue-600" />}
                {t === 'Docker' && <SiDocker className="text-blue-500" />}
                {t === 'Flutter' && <SiFlutter className="text-sky-500" />}
                {t === 'TypeScript' && <SiTypescript className="text-blue-600" />}
              </span>
              {t}
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</section>
