---
import MainLayout from '../layouts/MainLayout.astro';
import MaintenanceComponent from '../components/organisms/Maintenance.astro';

// Antes usaba Layout.astro, que traia el <title>Astro Basics</title> de la
// plantilla inicial, lang="en" y ningun metadato. Con MainLayout hereda el
// idioma, el canonical y las etiquetas sociales del resto del sitio.
const pageDetails = {
  title: "En mantenimiento",
  description: "Estamos realizando tareas de mantenimiento en yamid.dev. Volvemos en breve.",
  canonical: "https://www.yamid.dev/maintenance/",
};
---

<MainLayout
  title={pageDetails.title}
  description={pageDetails.description}
  canonical={pageDetails.canonical}
  header={false}
  noindex={true}
>
  <MaintenanceComponent />
</MainLayout>
