# Formulario de contacto (/api/contact)
# Crea una API key gratuita en https://resend.com/api-keys
RESEND_API_KEY=

# Dirección que recibe los mensajes del formulario
CONTACT_TO_EMAIL=tu-correo@ejemplo.com

# Remitente: debe pertenecer a un dominio verificado en Resend.
# Mientras verificas el tuyo puedes usar onboarding@resend.dev
CONTACT_FROM_EMAIL=contacto@yamid.dev
