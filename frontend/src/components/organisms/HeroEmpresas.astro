---
import { AHORA } from '../../lib/empresasData';

/**
 * Hero de la vertiente técnica.
 *
 * El skill exige identificación en 6 segundos: rol + stack real + ubicación,
 * sin adjetivos. Nada de "apasionado" ni "experiencias digitales increíbles":
 * esas frases no aportan información y el lector las descuenta.
 *
 * Va en .astro y no en React porque no tiene estado ni eventos: no hay razón
 * para enviar JavaScript por un bloque de texto.
 */
---

<section
  id="inicio"
  class="w-[95%] md:w-[90%] mx-auto pt-28 pb-14 sm:pt-32 sm:pb-16"
>
  <div class="max-w-3xl">
    <h1
      class="text-[clamp(2rem,5.5vw,3.5rem)] font-bold leading-[1.1] tracking-tight text-slate-900 dark:text-white"
    >
      Yamid Horacio Rodríguez
    </h1>

    <p class="mt-3 font-mono text-[clamp(0.9rem,2.2vw,1.05rem)] text-cyan-700 dark:text-cyan-400">
      Desarrollador full-stack · JavaScript, React, Astro, Python · Colombia · Modalidad remota
    </p>

    <p class="mt-5 max-w-2xl text-[clamp(0.95rem,2vw,1.1rem)] leading-relaxed text-slate-600 dark:text-slate-300">
      Tecnólogo en Análisis y Desarrollo de Software por el SENA, cursando Ingeniería de Sistemas
      en la UNAD. Desarrollo aplicaciones web con JavaScript y Python, y mantengo en producción
      los sistemas que despliego. El código de mis proyectos es público.
    </p>

    <!-- Bloque "Ahora": fechado a propósito. Uno desactualizado prueba que el
         sitio está muerto, así que la fecha va visible y se revisa cada mes. -->
    <div class="mt-8 rounded-lg bg-slate-100 p-5 ring-1 ring-slate-200 dark:bg-slate-900 dark:ring-slate-800">
      <div class="flex items-baseline gap-2">
        <h2 class="text-sm font-semibold text-slate-900 dark:text-white">Ahora</h2>
        <span class="font-mono text-xs text-slate-500 dark:text-slate-400">{AHORA.fecha}</span>
      </div>
      <ul class="mt-3 space-y-1.5">
        {AHORA.lineas.map((linea) => (
          <li class="flex gap-2 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
            <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-cyan-600 dark:bg-cyan-400" aria-hidden="true"></span>
            {linea}
          </li>
        ))}
      </ul>
      <p class="mt-3 text-sm font-medium text-slate-900 dark:text-white">{AHORA.disponibilidad}</p>
    </div>

    <!-- CTA único: lleva a la evidencia, no a "sobre mí". -->
    <div class="mt-8 flex flex-wrap gap-3">
      <a
        href="#proyectos"
        class="inline-flex min-h-[44px] items-center rounded-md bg-slate-900 px-5 text-sm font-medium text-white transition-colors hover:bg-slate-700 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:ring-offset-2 motion-reduce:transition-none dark:bg-white dark:text-slate-900 dark:hover:bg-slate-200 dark:focus-visible:ring-offset-slate-950"
      >
        Ver proyectos
      </a>
      <a
        href="#contacto"
        class="inline-flex min-h-[44px] items-center rounded-md px-5 text-sm font-medium text-slate-700 ring-1 ring-slate-300 transition-colors hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-cyan-500 focus-visible:ring-offset-2 motion-reduce:transition-none dark:text-slate-200 dark:ring-slate-700 dark:hover:bg-slate-800 dark:focus-visible:ring-offset-slate-950"
      >
        Contacto
      </a>
    </div>
  </div>
</section>
