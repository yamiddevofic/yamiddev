---
import MainLayout from '../../layouts/MainLayout.astro';
import { format } from 'date-fns';
import { es } from 'date-fns/locale/es';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => import.meta.env.DEV || !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<MainLayout
  title="Blog"
  description="Artículos sobre desarrollo web, Astro, React y todo lo que voy aprendiendo por el camino."
  canonical={new URL('/blog', Astro.site).toString()}
>
  <section class="mx-auto w-[90%] max-w-6xl pb-20 sm:pb-24">
    <div class="relative left-1/2 isolate flex min-h-[21rem] w-screen -translate-x-1/2 items-center overflow-hidden py-16 sm:min-h-[25rem] sm:py-24">
      <img src="/blog.jpg" alt="Cuaderno y notas de estudio" class="absolute inset-0 -z-20 h-full w-full object-cover object-center" width="1200" height="630" />
      <div class="absolute inset-0 -z-10 bg-gradient-to-br from-slate-950/95 via-slate-950/70 to-cyan-950/75" aria-hidden="true"></div>
      <div class="absolute -right-24 -top-24 -z-10 h-72 w-72 rounded-full bg-cyan-400/20 blur-3xl" aria-hidden="true"></div>
      <div class="relative mx-auto w-[90%] max-w-6xl text-white">
        <p class="mb-4 flex items-center gap-3 text-[0.68rem] font-semibold uppercase tracking-[0.16em] text-cyan-300 sm:mb-5 sm:text-xs sm:tracking-[0.18em]">
          <span class="h-px w-8 bg-cyan-300" aria-hidden="true"></span>
          Notas y decisiones
        </p>
        <h1 class="text-[clamp(2.25rem,6vw,4.5rem)] font-semibold leading-none tracking-[-0.055em]">
          Blog
        </h1>
        <p class="mt-5 max-w-xl text-sm leading-7 text-slate-200 sm:mt-6 sm:text-base">
          Notas sobre desarrollo web, Astro, React y todo lo que voy aprendiendo por el camino.
        </p>
      </div>
    </div>

    {posts.length === 0 ? (
      <div class="border-t border-slate-200 py-16 dark:border-slate-800">
        <h2 class="text-xl font-semibold text-slate-950 dark:text-white">
          Todavía no hay artículos
        </h2>
        <p class="mt-2 text-slate-500 dark:text-slate-400">Vuelve pronto para ver nuevos contenidos.</p>
      </div>
    ) : (
      <div class="mt-14 grid grid-cols-1 gap-10 lg:grid-cols-2">
        {posts.map((post, index) => (
          <article class:list={[
            'group flex h-full flex-col',
            index === 0 && 'lg:col-span-2 lg:grid lg:grid-cols-2 lg:gap-10',
          ]}>
            <a href={`/blog/${post.id}`} class="flex flex-col h-full">
              {post.data.image && (
                <div class:list={[
                  'relative aspect-[16/9] overflow-hidden border-b border-slate-200 pb-5 dark:border-slate-800',
                  index === 0 && 'lg:aspect-auto lg:border-0 lg:pb-0',
                ]}>
                  <img
                    src={post.data.image}
                    alt=""
                    width="400"
                    height="192"
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02] motion-reduce:transition-none"
                  />
                </div>
              )}

              <div class:list={[
                'flex flex-grow flex-col pb-6 pt-5',
                index === 0 && 'lg:justify-center lg:py-8',
              ]}>
                <time class="mb-3 font-mono text-xs text-slate-500 dark:text-slate-400" datetime={post.data.date.toISOString()}>
                  {format(post.data.date, 'dd MMM yyyy', { locale: es })}
                </time>
                <h2 class:list={[
                  'font-semibold tracking-tight text-slate-950 transition-colors group-hover:text-cyan-700 dark:text-white dark:group-hover:text-cyan-400',
                  index === 0 ? 'text-2xl leading-tight lg:text-4xl' : 'text-lg',
                ]}>
                  {post.data.title}
                </h2>

                <p class="mt-3 pb-5 line-clamp-3 text-sm leading-relaxed text-slate-600 dark:text-slate-300">
                  {post.data.description}
                </p>

                <div class="mt-auto flex items-center justify-end gap-4 border-t border-slate-200 pt-5 text-xs text-slate-500 dark:border-slate-800 dark:text-slate-400">
                  <span class="font-medium text-cyan-700 dark:text-cyan-400">Leer más</span>
                </div>
              </div>
            </a>
          </article>
        ))}
      </div>
    )}
  </section>
</MainLayout>
